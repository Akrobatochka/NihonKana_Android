<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FEFFAF"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="20dp">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="58dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnBackToRows"
            android:layout_width="110dp"
            android:layout_height="48dp"
            android:layout_gravity="start|center_vertical"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="К рядам"
            android:textAllCaps="false"
            android:textColor="#000000"
            android:textSize="14sp"
            app:backgroundTint="#FDE5E8"
            app:cornerRadius="24dp"
            app:strokeColor="#7B585A"
            app:strokeWidth="1dp" />

        <ImageView
            android:id="@+id/ivPlaySound"
            android:layout_width="76dp"
            android:layout_height="100dp"
            android:layout_gravity="end|center_vertical"
            android:contentDescription="Воспроизвести звук"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_sound" />

    </FrameLayout>

    <TextView
        android:id="@+id/tvCardCounter"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="1 из 5"
        android:textColor="#999D4F"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvSymbol"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="あ"
        android:textColor="#000000"
        android:textSize="80sp" />

    <TextView
        android:id="@+id/tvRomaji"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="a"
        android:textColor="#000000"
        android:textSize="24sp"
        android:textStyle="bold" />

    <ImageView
        android:id="@+id/ivAssociation"
        android:layout_width="200dp"
        android:layout_height="200dp"
        android:layout_marginTop="12dp"
        android:contentDescription="Картинка ассоциации"
        android:scaleType="fitCenter" />

    <FrameLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp">

        <ImageView
            android:layout_width="240dp"
            android:layout_height="200dp"
            android:scaleType="fitCenter"
            android:src="@drawable/dialog_sverhu" />

        <TextView
            android:id="@+id/tvAssociationText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="45dp"
            android:gravity="center"
            android:paddingHorizontal="40dp"
            android:text="Арбуз"
            android:textColor="#000000"
            android:textSize="20sp"
            android:textStyle="bold" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="bottom|center_horizontal"
        android:orientation="horizontal"
        android:paddingBottom="10dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPrevious"
            android:layout_width="130dp"
            android:layout_height="54dp"
            android:text="Назад"
            android:textColor="#FFFFFF"
            app:backgroundTint="#999D4F"
            app:cornerRadius="8dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnNext"
            android:layout_width="130dp"
            android:layout_height="54dp"
            android:layout_marginStart="20dp"
            android:text="Вперёд"
            android:textColor="#FFFFFF"
            app:backgroundTint="#999D4F"
            app:cornerRadius="8dp" />
    </LinearLayout>

</LinearLayout>