<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FDE5E8"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="20dp">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnBack"
            android:layout_width="110dp"
            android:layout_height="50dp"
            android:layout_centerVertical="true"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="Назад"
            android:textAllCaps="false"
            android:textColor="#000000"
            android:textSize="16sp"
            app:backgroundTint="#FEFFAF"
            app:cornerRadius="25dp"
            app:strokeColor="#999D4F"
            app:strokeWidth="1dp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerHorizontal="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:src="@drawable/ic_logo" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Nihon Kana"
                android:textColor="#A4565C"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>
    </RelativeLayout>

    <TextView
        android:id="@+id/tvGrammarMenuTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="40dp"
        android:layout_marginBottom="30dp"
        android:text="Грамматика"
        android:textColor="#7B585A"
        android:textSize="26sp"
        android:textStyle="bold" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnHiraganaGrammar"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_marginHorizontal="10dp"
        android:layout_marginTop="12dp"
        android:text="Хирагана"
        android:textAllCaps="false"
        android:textColor="#999D4F"
        android:textSize="18sp"
        android:textStyle="bold"
        app:backgroundTint="#FEFFAF"
        app:cornerRadius="12dp"
        app:strokeColor="#999D4F"
        app:strokeWidth="1dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnKatakanaGrammar"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_marginHorizontal="10dp"
        android:layout_marginTop="16dp"
        android:text="Катакана"
        android:textAllCaps="false"
        android:textColor="#999D4F"
        android:textSize="18sp"
        android:textStyle="bold"
        app:backgroundTint="#FEFFAF"
        app:cornerRadius="12dp"
        app:strokeColor="#999D4F"
        app:strokeWidth="1dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnAdditionalSoundsGrammar"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_marginHorizontal="10dp"
        android:layout_marginTop="16dp"
        android:text="Дополнительные звуки"
        android:textAllCaps="false"
        android:textColor="#999D4F"
        android:textSize="18sp"
        android:textStyle="bold"
        app:backgroundTint="#FEFFAF"
        app:cornerRadius="12dp"
        app:strokeColor="#999D4F"
        app:strokeWidth="1dp" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ImageView
            android:id="@+id/ivCatGrammar"
            android:layout_width="450dp"
            android:layout_height="200dp"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="20dp"
            android:scaleType="fitCenter"
            android:src="@drawable/smart_cat" />
    </FrameLayout>

</LinearLayout>