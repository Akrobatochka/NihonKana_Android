<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:padding="28dp"
    android:background="#FEFFAF">

    <TextView
        android:id="@+id/tvResultTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="40dp"
        android:layout_marginBottom="32dp"
        android:text="Упражнение\nзавершено"
        android:textSize="32sp"
        android:textStyle="bold"
        android:textColor="#000000"
        android:gravity="center"
        android:lineSpacingExtra="4dp" />

    <ImageView
        android:id="@+id/imgResultCat"
        android:layout_width="220dp"
        android:layout_height="220dp"
        android:layout_marginBottom="36dp"
        android:scaleType="fitCenter"
        android:src="@drawable/happy_cat"
        android:contentDescription="Победный котик" />

    <TextView
        android:id="@+id/tvResultInfo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="48dp"
        android:text="Результат: 5 из 50\nОшибок: 41\nПравильных ответов: 10%"
        android:textSize="20sp"
        android:textColor="#000000"
        android:lineSpacingExtra="8dp"
        android:textStyle="bold" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnExitResult"
        android:layout_width="220dp"
        android:layout_height="60dp"
        android:text="Выход"
        android:textAllCaps="false"
        android:textColor="#000000"
        android:textSize="20sp"
        android:textStyle="bold"
        app:backgroundTint="#FDE5E8"
        app:cornerRadius="30dp"
        app:strokeColor="#7B585A"
        app:strokeWidth="1dp" />

</LinearLayout>